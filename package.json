{
  "name": "speech-test",
  "version": "0.1.0",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "puppeteer-core": "^25.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "description": "Provider 주입형 실시간 STT 콘솔 — Web Speech API / Qwen3 ASR",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/fetch-local-assets.mjs",
    "qa:samples": "node scripts/qa/select-samples.mjs",
    "qa:stt": "node scripts/qa/run.mjs",
    "qa:gate": "node scripts/qa/gate.mjs",
    "qa:mic": "node scripts/qa/verify-mic.mjs",
    "qa:hooks": "git config core.hooksPath .githooks"
  },
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^3"
  }
}
